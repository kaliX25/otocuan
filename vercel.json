{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd mobile && npm install --no-audit --no-fund",
  "buildCommand": "cd mobile && npx expo export -p web",
  "outputDirectory": "mobile/dist",
  "functions": { "api/index.py": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/|_expo/|assets/).*)", "destination": "/index.html" }
  ]
}
